# Required server-side credentials. Copy this file to .env and provide real values.
DB_PASSWORD=replace-with-database-password

# SHA-256 digest of the existing salesman mobile app API key (64 hex characters).
MOBILE_API_KEY_SHA256=replace-with-mobile-api-key-sha256

# Optional server-side MyInvois access. Required for e-Invoice retrieval/linking.
# Production: https://api.myinvois.hasil.gov.my
# Sandbox: https://preprod-api.myinvois.hasil.gov.my
# Use credentials for the matching environment. Leave blank to keep disabled.
# After changing these values, restart the backend. Do not use VITE_ prefixes.
MYINVOIS_API_BASE_URL=
MYINVOIS_CLIENT_ID=
MYINVOIS_CLIENT_SECRET=
